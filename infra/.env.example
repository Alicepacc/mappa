# Copy to infra/.env and adjust. Never commit the real file.

# --- Product -----------------------------------------------------------------
# SPEC §0.2: the product name is a placeholder, configurable here.
APP_NAME=Mappa
APP_VERSION=0.0.0-m0

# --- Data --------------------------------------------------------------------
# Which pipeline output to serve: dev (Dolomites) or italy (production).
AREA=dev
# Host path holding pipeline output (*.pmtiles, coverage.geojson, manifest.json).
DATA_DIR=../data

# --- Ports (host side) -------------------------------------------------------
WEB_PORT=8000
GATEWAY_PORT=8080
TILES_PORT=8081
VALHALLA_PORT=8002
PHOTON_PORT=2322

# --- Gateway -----------------------------------------------------------------
LOG_LEVEL=info
# Comma-separated browser origins, or * in local development.
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Frontend build ----------------------------------------------------------
# Empty API base means "same origin", which is how Caddy serves it in compose.
VITE_API_BASE=
VITE_TILE_BASE=http://localhost:8081
