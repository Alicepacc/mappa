# Frontend host (SPEC §2.2).
#
# Serves the built SPA and reverse-proxies /api to the gateway so the browser
# talks to a single origin.
{
	admin off
	auto_https off
}

:80 {
	handle /api/* {
		reverse_proxy gateway:8080
	}

	handle {
		root * /srv
		encode gzip zstd

		# Hashed assets never change; index.html must not be cached.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@index path / /index.html
		header @index Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
