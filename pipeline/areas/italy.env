# Production area: the whole Italian Republic (SPEC §1.0, §3.0).
#
# Coverage is the OSM admin_level=2 boundary including islands, plus the
# enclaves San Marino and Vatican City and the Campione d'Italia exclave. This
# bbox is the coarse clip; the exact polygon comes from step 2.
AREA_NAME=italy
AREA_BBOX_WEST=6.60
AREA_BBOX_SOUTH=35.29
AREA_BBOX_EAST=18.80
AREA_BBOX_NORTH=47.10

BASEMAP_MAX_ZOOM=14
CONTOUR_MIN_ZOOM=11
CONTOUR_MAX_ZOOM=14
CONTOUR_INTERVAL_M=10
CONTOUR_INDEX_M=50
CONTOUR_INDEX_MAJOR_M=100
TERRAIN_MIN_ZOOM=0
TERRAIN_MAX_ZOOM=13
