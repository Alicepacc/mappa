# Development area: Val Gardena / Val di Fassa / Sella group (SPEC §3.0).
#
# Chosen because it is dense in exactly the features that make this map
# distinctive — CAI trails, via ferrate, rifugi and bivacchi, downhill and
# nordic pistes, aerialways — and trilingual (Italian, German, Ladin), so the
# label-language rules in SPEC §4.1 are exercised on real data.
AREA_NAME=dev
AREA_BBOX_WEST=11.55
AREA_BBOX_SOUTH=46.35
AREA_BBOX_EAST=11.95
AREA_BBOX_NORTH=46.65

# Vector tile zoom range (SPEC §3.1 step 3).
BASEMAP_MAX_ZOOM=14
# Contours (SPEC §3.1 step 4).
CONTOUR_MIN_ZOOM=11
CONTOUR_MAX_ZOOM=14
CONTOUR_INTERVAL_M=10
CONTOUR_INDEX_M=50
CONTOUR_INDEX_MAJOR_M=100
# Terrain RGB (SPEC §3.1 step 4).
TERRAIN_MIN_ZOOM=0
TERRAIN_MAX_ZOOM=13
